# Copy to .secrets/agent.env (gitignored) or set these as environment variables.
# NEVER commit real values: this repository is public.

# --- secrets -------------------------------------------------------------
# Base58 64-byte secret key of the agent wallet (npm run keygen creates one).
AGENT_SECRET_KEY=
# familiars agent API key (fam_...), returned once by npm run register.
FAMILIARS_API_KEY=

# --- mode ----------------------------------------------------------------
# paper (default): real quotes, simulated fills, no posts. live: real swaps.
TRADING_MODE=paper
# Public posts on familiars. Defaults to on in live mode, off in paper mode.
# POSTING=on

# --- optional ------------------------------------------------------------
# A private RPC (Helius, Triton...) is more reliable than the public one.
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# JUPITER_API_BASE=https://lite-api.jup.ag
# JUPITER_API_KEY=
# PAPER_START_USD=1000
# STATE_PATH=state/agent.live.local.json
# FAMILIARS_SECRETS_FILE=.secrets/agent.env
# LOG_LEVEL=info
